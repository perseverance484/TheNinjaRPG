{
  "name": "tnr-battle-replay-reference",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts harness",
    "build": "vite build --config vite.config.ts harness --outDir ../dist --emptyOutDir",
